# Exemplo de configuração para o cluster Apuana.
#
# Copie para cluster/config.env, ajuste os caminhos e faça:
#   set -a; source cluster/config.env; set +a
#
# Os scripts também aceitam as mesmas variáveis exportadas no shell.

# Área de armazenamento. $SCRATCH é rápida, sem quota e limpa após 90 dias.
# Se $SCRATCH não existir no seu login, use $HOME.
export SCRATCH="${SCRATCH:-$HOME}"

export VENV="${VENV:-$SCRATCH/replicating-repo-venv}"
export DATA_ROOT="${DATA_ROOT:-$SCRATCH/replicating-repo-data}"
export RESULTS_ROOT="${RESULTS_ROOT:-$SCRATCH/replicating-repo-results}"

# Módulo Python do Apuana. Deixe vazio para o setup tentar descobrir.
# Exemplos: Python/3.10, Python3.10, miniforge3/2025.07.
export PYTHON_MODULE="${PYTHON_MODULE:-}"

# Recursos SLURM.
export PARTITION="${PARTITION:-short-simple}"
export CPUS_PER_TASK="${CPUS_PER_TASK:-8}"
export MEM="${MEM:-32G}"
export GRES="${GRES:-gpu:1}"
export CONCURRENCY="${CONCURRENCY:-2}"

# Tempos máximos. O ataque de pacotes chega a ~23 h; 47 h deixa margem.
export WALLTIME_TRAIN="${WALLTIME_TRAIN:-1-00:00:00}"
export WALLTIME_NORMAL="${WALLTIME_NORMAL:-02:00:00}"
export WALLTIME_ADV="${WALLTIME_ADV:-1-23:00:00}"

# Opcional: fixar um nó com A100 (ex.: cluster-node6) para todos os jobs.
# export NODELIST=""

# Reprodutibilidade. A nota original não fixa seed; usamos 2019 para que
# uma nova execução e uma retomada gerem os mesmos resultados.
export SEED="${SEED:-2019}"

# Modelos avaliados por padrão. Use "retrained" para avaliar o que o
# cluster treinou; "pretrained" usa os modelos dos autores em models/.
export MODEL_SOURCE="${MODEL_SOURCE:-pretrained}"
