# Exemplo de configuração para o cluster Apuana.
#
# Copie para cluster/config.env, ajuste os caminhos e faça:
#   set -a; source cluster/config.env; set +a
#
# Os scripts também aceitam as mesmas variáveis exportadas no shell.

# Área de armazenamento. $SCRATCH é rápida, sem quota e limpa após 90 dias.
# Se $SCRATCH não existir no seu login, use $HOME.
export SCRATCH="${SCRATCH:-$HOME}"

export VENV="${VENV:-$SCRATCH/replicating-repo-venv}"
export DATA_ROOT="${DATA_ROOT:-$SCRATCH/replicating-repo-data}"
export RESULTS_ROOT="${RESULTS_ROOT:-$SCRATCH/replicating-repo-results}"

# Módulo Python do Apuana. Deixe vazio para usar o Python do sistema.
# ATENÇÃO: o miniforge existe apenas nos nós de login; um venv criado a partir
# dele não funciona nos nós de computação. Use /usr/bin/python3.10.
export PYTHON_MODULE="${PYTHON_MODULE:-}"

# Recursos SLURM.
export PARTITION="${PARTITION:-short-simple}"
export CPUS_PER_TASK="${CPUS_PER_TASK:-8}"
export MEM="${MEM:-32G}"
export GRES="${GRES:-gpu:1}"
export CONCURRENCY="${CONCURRENCY:-2}"

# Tempos máximos. O ataque de pacotes chega a ~23 h; 47 h deixa margem.
export WALLTIME_TRAIN="${WALLTIME_TRAIN:-1-00:00:00}"
export WALLTIME_NORMAL="${WALLTIME_NORMAL:-02:00:00}"
export WALLTIME_ADV="${WALLTIME_ADV:-1-23:00:00}"

# Novo dataset (data/new_data). O normal tem ~3,59 M linhas; 2 h dão margem.
export WALLTIME_NEW_DATA_NORMAL="${WALLTIME_NEW_DATA_NORMAL:-02:00:00}"
export WALLTIME_NEW_DATA_ADV="${WALLTIME_NEW_DATA_ADV:-1-23:00:00}"
export WALLTIME_NEW_DATA_TRAIN="${WALLTIME_NEW_DATA_TRAIN:-1-00:00:00}"

# Ajustes opcionais dos jobs do novo dataset.
# export NEW_DATA_MODES="repo,repo_plus"
# export MAX_SAMPLES=5000
# export N_MASKS=100
# export BATCH_SIZE=1024
# export CHECKPOINT_EVERY=50
# export SCORE_REPEATS=1
# export PAIRED_SCORING=0

# Máscaras (eficiência do RePO). Os defaults são os de produção; reduza
# MASK_MAX_BENIGN/MASK_PER_ATTACK para um smoke.
export WALLTIME_MASK_BASELINE="${WALLTIME_MASK_BASELINE:-02:00:00}"
export WALLTIME_MASK_VARIANCE="${WALLTIME_MASK_VARIANCE:-06:00:00}"
export WALLTIME_MASK_ADV="${WALLTIME_MASK_ADV:-1-23:00:00}"
export WALLTIME_MASK_CASCADE="${WALLTIME_MASK_CASCADE:-06:00:00}"
export WALLTIME_MASK_DISTILL="${WALLTIME_MASK_DISTILL:-06:00:00}"
export WALLTIME_MASK_PACKET="${WALLTIME_MASK_PACKET:-06:00:00}"
export WALLTIME_MASK_AGGREGATE="${WALLTIME_MASK_AGGREGATE:-00:30:00}"

# export MASK_MAX_BENIGN=100000
# export MASK_MAX_PER_ATTACK=5000
# export MASK_PER_ATTACK=5000
# export MASK_N_MASKS=100
# export MASK_VARIANCE_N="5,10,20,25,50,100"
# export MASK_POLICIES="iid,balanced,covering"
# export MASK_REPEATS=3
# export MASK_VARIANTS="iid:100,iid:25,balanced:25,covering:25"
# export MASK_CHEAP="5,10,25"
# export MASK_CHEAP_ATTACK="5,25"
# export MASK_CASCADE_FN=0.01
# export MASK_EPOCHS=40
# export MASK_PACKET_WINDOWS=2000
# export MASK_BATCH_SIZE=1024
# export MASK_ATTACK_SET=pilot   # ou all (11 ataques)

# Nós com defeito a evitar. Use --exclude em vez de --nodelist: uma lista de
# hosts em --nodelist faz o Slurm pedir um nó por host.
# export EXCLUDE="cluster-node4,cluster-node10"
# Alternativa: fixar um único nó com NODELIST="cluster-node6".

# Reprodutibilidade. A nota original não fixa seed; usamos 2019 para que
# uma nova execução e uma retomada gerem os mesmos resultados.
export SEED="${SEED:-2019}"

# Modelos avaliados por padrão. Use "retrained" para avaliar o que o
# cluster treinou; "pretrained" usa os modelos dos autores em models/.
export MODEL_SOURCE="${MODEL_SOURCE:-pretrained}"
